# Root-level example. Each app has its own: backend/src/Api/appsettings.Development.json, frontend/.env.example
# Never commit real secrets. docker-compose.yml carries local-only defaults, so `docker compose up`
# works with no .env at all; set these to override them.

# Host port for Postgres. Change it if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# Local database password. docker-compose.yml hardcodes this same value for the db service.
POSTGRES_PASSWORD=universitylostfound

# Signs the staff session token. At least 32 bytes; a real deployment generates its own.
JWT_SIGNING_KEY=development-only-signing-key-change-me-32b

# Password given to the seeded staff accounts (UM-204718, UM-916035). Local demo only: outside
# Development the API refuses to seed unless Seed__StaffPassword is private and 12+ characters.
SEED_STAFF_PASSWORD=staffdemo123

# --- Deployed API. Set on the host; docker-compose.yml sets them itself locally. ---
ConnectionStrings__Default=Host=db.example.com;Port=5432;Database=universitylostfound;Username=universitylostfound;Password=change-me;SSL Mode=Require
Cors__AllowedOrigins__0=https://example.vercel.app
Database__MigrateOnStartup=true
Database__SeedOnStartup=true
Jwt__SigningKey=deployment-only-signing-key-change-me-32b
Seed__StaffPassword=change-me-to-12-plus-chars
# Networks whose X-Forwarded-For is trusted (the proxy / load balancer in front of the API).
# Defaults to private ranges; a public-range proxy must be listed or every caller shares one rate-limit bucket.
# Proxy__TrustedNetworks__0=203.0.113.0/24
# Restrict the Host header to your api domain(s), semicolon separated.
# AllowedHosts=api.example.com
